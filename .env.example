# demo: runnable without API keys; openai: Responses API; ollama: local model.
LLM_PROVIDER=demo
# Select a model available to your account / installed in Ollama.
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=900
MAX_INPUT_CHARS=2000
MAX_HISTORY_MESSAGES=8
CHAT_LIMIT_24H=40
# Paths are relative to the project root unless absolute.
# Optional: default uses an existing local database, otherwise data/breakout_ai.sqlite3.
# DATABASE_PATH=data/breakout_ai.sqlite3
# Local workspace identifier, NOT an authentication mechanism.
WORKSPACE_ID=local
# Public research sources; requests are made only after user actions.
MARKET_DATA_ENABLED=true
VN_MARKET_PROVIDER=kbs
US_MARKET_PROVIDER=yahoo
MARKET_TIMEOUT_SECONDS=15
MARKET_CACHE_SECONDS=300
MARKET_MAX_SYMBOLS=6
# Optional operator-owned endpoint backed by your licensed data source.
# Set VN_MARKET_PROVIDER and/or US_MARKET_PROVIDER to gateway to use it.
MARKET_GATEWAY_URL=
MARKET_GATEWAY_TOKEN=
